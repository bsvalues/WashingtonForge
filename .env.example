# WashingtonForge — environment template
# Copy to `.env` (or `.env.local`) and fill in real values.
# Only the no-secret template (.env.example) is committed; .env is gitignored.

# ---------------------------------------------------------------------------
# Data layer (server-side, lib/db)
# ---------------------------------------------------------------------------
# Read-only parcel fabric (PostGIS). Points at the cloned benton_geo database.
# When unset, the app runs in pure demo mode (no database required).
WF_GEO_DATABASE_URL=postgres://wf:wf-dev-clone-2026@127.0.0.1:5434/benton_geo

# Writable app state (notes, review status). Points at the washingtonforge DB.
WF_APP_DATABASE_URL=postgres://wf:wf-dev-clone-2026@127.0.0.1:5434/washingtonforge

# Redis cache (optional). When unset, the cache layer degrades to a no-op.
WF_REDIS_URL=redis://127.0.0.1:6379

# Max connections per pool (default 10).
WF_PG_POOL_MAX=10

# ---------------------------------------------------------------------------
# Demo mode (client-visible, inlined at build time)
# ---------------------------------------------------------------------------
# "true" or unset  → demo mode ON (simulated data helpers enabled)
# "false"          → demo mode OFF (real backend expected)
# NOTE: server-side provenance is decided by actual DB connectivity
# (see /api/health), independent of this flag.
NEXT_PUBLIC_DEMO_MODE=true
