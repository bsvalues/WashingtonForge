# WashingtonForge data-plane secrets — copy to infra/.env and fill in.
# infra/.env is gitignored. NEVER commit real passwords.

# Postgres (wf-postgres, port 5434)
WF_PG_DB=washingtonforge
WF_PG_USER=wf
WF_PG_PASSWORD=CHANGE_ME

# Redis — reuse the hub's shared redis by default.
# Set to 127.0.0.1:6380 if you started our own via `docker compose --profile redis up -d`.
WF_REDIS_URL=redis://127.0.0.1:6379
